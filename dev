#!/usr/bin/env bash
#
# Short commands for developing JussiMiniPos: the app and the containers.
#
#   ./dev run [args]      clean, build and start the Windows app; args go to dotnet run
#   ./dev installer       publish JussiMiniPos.exe and build the Windows installer
#   ./dev up              start PostgreSQL and pgAdmin, and wait until both are ready
#   ./dev down            stop them; the data is kept
#   ./dev restart         recreate both containers (force), keeping the data
#   ./dev status          show the containers and their health
#   ./dev logs [service]  follow the logs (Ctrl+C to stop), e.g. ./dev logs pgadmin
#   ./dev reset [--force] stop them and DELETE the data volumes, after asking
#
# Runs in Git Bash on Windows, and in WSL, macOS or Linux, from any folder;
# `run` needs Windows, since the app is WPF. The containers are for
# development and the tests only; a till in a shop points at its own
# PostgreSQL server through database.env.

set -euo pipefail

# docker compose finds docker-compose.yml, and resolves its relative paths,
# from the repository root.
cd "$(dirname "${BASH_SOURCE[0]}")"

usage() {
    sed -n '3,12p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

require_dotnet() {
    if ! command -v dotnet > /dev/null 2>&1; then
        echo "dotnet was not found. Install the .NET 10 SDK, then run this again." >&2
        exit 1
    fi
}

endpoints() {
    echo
    echo "PostgreSQL  localhost:5432   database jussiminipos, user jussipos, password jussipos"
    echo "pgAdmin     http://localhost:5050"
}

command="${1:-help}"
shift || true

# Only the container commands need Docker.
case "$command" in
    up | down | restart | status | logs | reset)
        if ! command -v docker > /dev/null 2>&1; then
            echo "Docker was not found. Install Docker Desktop and start it, then run this again." >&2
            exit 1
        fi
        ;;
esac

case "$command" in
    run)
        require_dotnet
        # A clean build every time, so a stale obj/ (such as WPF's generated
        # files after a branch switch) can never be what is running.
        dotnet clean src/JussiMiniPos --nologo --verbosity quiet
        # Uses whatever database.env or JUSSIMINIPOS_DB_* points at, the same
        # as any other start; for the dev PostgreSQL, run ./dev up first.
        dotnet run --project src/JussiMiniPos "$@"
        ;;
    installer)
        require_dotnet
        # installer/build.ps1 publishes the self-contained single-file exe and
        # compiles the Inno Setup installer over it; it is PowerShell, so it
        # runs under Windows PowerShell rather than being duplicated here.
        if ! command -v powershell.exe > /dev/null 2>&1; then
            echo "Building the installer needs Windows (powershell.exe and Inno Setup)." >&2
            exit 1
        fi
        powershell.exe -NoProfile -ExecutionPolicy Bypass -File installer/build.ps1
        echo
        echo "Application  src/JussiMiniPos/bin/Release/net10.0-windows/win-x64/publish/JussiMiniPos.exe"
        ;;
    up)
        # --wait returns once the health checks pass, so the database accepts
        # connections and pgAdmin answers when this finishes.
        docker compose up --detach --wait
        endpoints
        ;;
    down)
        docker compose down
        ;;
    restart)
        docker compose up --detach --force-recreate --wait
        endpoints
        ;;
    status)
        docker compose ps
        ;;
    logs)
        docker compose logs --follow --tail 100 "$@"
        ;;
    reset)
        if [[ "${1:-}" != "--force" ]]; then
            read -r -p "Delete the development PostgreSQL and pgAdmin data? Type yes to continue: " answer
            if [[ "$answer" != "yes" ]]; then
                echo "Nothing was deleted."
                exit 0
            fi
        fi
        docker compose down --volumes
        echo "Development data deleted. Run ./dev up to start again with an empty database."
        ;;
    help | -h | --help)
        usage
        ;;
    *)
        echo "Unknown command: $command" >&2
        echo >&2
        usage >&2
        exit 2
        ;;
esac
