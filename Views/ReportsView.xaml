<UserControl x:Class="JussiMiniPos.Views.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Takaisin" Style="{StaticResource Button.Ghost}" Click="Back_Click" />
            <TextBlock Text="Raportit" Style="{StaticResource Text.SectionHeader}" FontSize="26"
                       Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12" Margin="0,0,0,12">
            <StackPanel IsEnabled="{Binding CanLoad}">
                <WrapPanel Margin="0,0,0,8">
                    <Button Content="Tänään" Tag="today" Style="{StaticResource Button.Ghost}" Click="Preset_Click" />
                    <Button Content="Tämä viikko" Tag="week" Style="{StaticResource Button.Ghost}" Click="Preset_Click" />
                    <Button Content="Tämä kuukausi" Tag="month" Style="{StaticResource Button.Ghost}" Click="Preset_Click" />
                    <TextBlock Text="Päivämäärät Suomen ajassa" Style="{StaticResource Text.Muted}" Margin="16,0,0,0" VerticalAlignment="Center" />
                </WrapPanel>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Label Content="Alkaen" Target="{Binding ElementName=FromPicker}" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" Padding="0,0,10,0" />
                        <DatePicker x:Name="FromPicker" Width="180" Style="{StaticResource FormDatePicker}"
                                    SelectedDate="{Binding From, Mode=TwoWay}" DateValidationError="Date_ValidationError"
                                    AutomationProperties.Name="Alkupäivä" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,12,0">
                        <Label Content="Asti" Target="{Binding ElementName=ThroughPicker}" VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextMuted}" Padding="0,0,10,0" />
                        <DatePicker x:Name="ThroughPicker" Width="180" Style="{StaticResource FormDatePicker}"
                                    SelectedDate="{Binding Through, Mode=TwoWay}" DateValidationError="Date_ValidationError"
                                    AutomationProperties.Name="Loppupäivä" />
                    </StackPanel>
                    <Button Content="Näytä raportti" Width="140" Style="{StaticResource Button.Primary}" Click="Load_Click" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2">
            <TextBlock Text="{Binding Notice}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8"
                       AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12"
                    Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
                <UniformGrid Columns="4">
                    <StackPanel>
                        <TextBlock Text="Myynti yhteensä" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Report.Total, StringFormat={}{0:N2} €}" Style="{StaticResource Text.Metric}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Myyntitapahtumia" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Report.SaleCount}" Style="{StaticResource Text.Metric}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Myytyjä kappaleita" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Report.ItemCount}" Style="{StaticResource Text.Metric}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Keskiostos" Style="{StaticResource Text.Muted}" />
                        <TextBlock Text="{Binding Report.AverageSale, StringFormat={}{0:N2} €}" Style="{StaticResource Text.Metric}" />
                    </StackPanel>
                </UniformGrid>
            </Border>
        </StackPanel>
        <Grid Grid.Row="3" Visibility="{Binding HasReport, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ListBox Style="{StaticResource ChipList}" ItemContainerStyle="{StaticResource ChipItem}"
                     ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTab}" Margin="0,0,0,8"
                     AutomationProperties.Name="Raportin ryhmittely" />
            <TextBlock Grid.Row="1" Text="{Binding TableNotice}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,8" />
            <DataGrid Grid.Row="2" Style="{StaticResource Table.ReadOnly}" ItemsSource="{Binding Report.Days}"
                      Visibility="{Binding IsDaily, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Päivittäinen myynti">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Päivä" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="*" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Myyntejä" Binding="{Binding SaleCount}" Width="90" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTextColumn Header="Kappaleita" Binding="{Binding ItemCount}" Width="95" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTextColumn Header="Myynti (€)" Binding="{Binding Total, StringFormat=N2}" Width="120" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTemplateColumn Header="Myynnin kehitys" Width="155" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Width="{Binding BarWidth}" Height="14" Background="{StaticResource Brush.Accent}"
                                        HorizontalAlignment="Left" Margin="10,0" VerticalAlignment="Center" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tapahtumat" Width="130" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Näytä myynnit" Style="{StaticResource Button.Ghost}" Click="Day_Click" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="2" Style="{StaticResource Table.ReadOnly}" ItemsSource="{Binding Report.Products}"
                      Visibility="{Binding IsProducts, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Tuotekohtainen myynti">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tuotenro" Binding="{Binding ProductId}" Width="100" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Tuote" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Kappaleita" Binding="{Binding ItemCount}" Width="120" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTextColumn Header="Myynti (€)" Binding="{Binding Total, StringFormat=N2}" Width="150" ElementStyle="{StaticResource Table.Number}" />
                </DataGrid.Columns>
            </DataGrid>
            <DataGrid Grid.Row="2" Style="{StaticResource Table.ReadOnly}" ItemsSource="{Binding Report.Categories}"
                      Visibility="{Binding IsCategories, Converter={StaticResource BoolToVis}}" AutomationProperties.Name="Kategoriakohtainen myynti">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Kategoria" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Kappaleita" Binding="{Binding ItemCount}" Width="120" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTextColumn Header="Myynti (€)" Binding="{Binding Total, StringFormat=N2}" Width="150" ElementStyle="{StaticResource Table.Number}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
