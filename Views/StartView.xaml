<UserControl x:Class="JussiMiniPos.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="900">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">

        <!-- The logo is the title: it carries the name already, so a
             "JussiMiniPos" heading under it only said it twice. -->
        <ContentControl Style="{StaticResource Logo}" Width="300"
                        HorizontalAlignment="Center" Margin="0,0,0,4"
                        AutomationProperties.Name="Jussi mini-POS" />

        <TextBlock Text="Tervetuloa JussiMiniPos -järjestelmään."
                   Style="{StaticResource Text.Subtitle}" />

        <UniformGrid Rows="1" Columns="4" Margin="0,44,0,0">
            <Button Style="{StaticResource Tile}"
                    Tag="{StaticResource Icon.Checkout}"
                    Content="Kassa"
                    Click="Checkout_Click" />
            <Button Style="{StaticResource Tile}"
                    Tag="{StaticResource Icon.Products}"
                    Content="Tuotteet"
                    Click="Products_Click" />
            <Button Style="{StaticResource Tile}"
                    Tag="{StaticResource Icon.Sales}"
                    Content="Myynti"
                    Click="Sales_Click" />
            <Button Style="{StaticResource Tile}"
                    Tag="{StaticResource Icon.Reports}"
                    Content="Raportit"
                    Click="Reports_Click" />
        </UniformGrid>

    </StackPanel>

        <!-- Session and settings rather than destinations, so they sit apart
             from the tiles instead of becoming more of them. -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,22">

            <!-- Who is signed in, and the way to their own details. Shown
                 rather than implied, because it is what decides whether Admin
                 opens. -->
            <Button Style="{StaticResource Button.Ghost}"
                    ToolTip="Oma profiili"
                    Click="Profile_Click"
                    AutomationProperties.Name="Oma profiili"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.User}"
                                    Width="15" Height="15"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SignedInText}" Margin="8,0,0,0"
                               VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Button.Ghost}"
                    Click="Login_Click"
                    AutomationProperties.Name="Kirjaudu sisään"
                    Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.User}"
                                    Width="15" Height="15"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Kirjaudu" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Button.Ghost}"
                    Click="Admin_Click"
                    AutomationProperties.Name="Admin">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Settings}"
                                    Width="15" Height="15"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Admin" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>

            <Button Style="{StaticResource Button.Ghost}"
                    Click="Logout_Click"
                    AutomationProperties.Name="Kirjaudu ulos"
                    Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.LogOut}"
                                    Width="15" Height="15"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Kirjaudu ulos" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="13" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Corner-stamped rather than part of the row above: it is a fact
             about the build, not something to interact with. Shares the row's
             cell, which the session buttons never grow wide enough to reach. -->
        <TextBlock Grid.Row="1"
                   Text="{Binding Version}"
                   Style="{StaticResource Text.Muted}" FontSize="12"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom"
                   Margin="0,0,18,20"
                   AutomationProperties.Name="Sovelluksen versio" />
    </Grid>
</UserControl>
