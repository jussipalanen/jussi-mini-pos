<UserControl x:Class="JussiMiniPos.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <DockPanel Grid.Row="0" Margin="0,0,0,18">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Height="46" Padding="16,0"
                        AutomationProperties.Name="Kategoriat"
                        Click="Categories_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}"
                                        Tag="{StaticResource Icon.Products}"
                                        Width="16" Height="16"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="Kategoriat" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Button.Primary}" Width="170" Margin="10,0,0,0"
                        AutomationProperties.Name="Uusi tuote"
                        Click="New_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}"
                                        Tag="{StaticResource Icon.Plus}"
                                        Width="16" Height="16"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="Uusi tuote" Margin="8,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource Button.Ghost}" Click="Back_Click" Padding="10,0"
                        AutomationProperties.Name="Takaisin">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icon}"
                                        Tag="{StaticResource Icon.ArrowLeft}"
                                        Width="16" Height="16"
                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                        VerticalAlignment="Center" />
                        <TextBlock Text="Takaisin" Margin="7,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock Text="Tuotteet" Style="{StaticResource Text.SectionHeader}"
                           FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search -->
                <TextBox Grid.Row="0"
                         Style="{StaticResource SearchBox}"
                         Tag="Hae tuotenumerolla tai nimellä…"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- Category filter -->
                <ListBox Grid.Row="1"
                         Margin="0,14,0,4"
                         Style="{StaticResource ChipList}"
                         ItemContainerStyle="{StaticResource ChipItem}"
                         ItemsSource="{Binding Categories}"
                         DisplayMemberPath="Title"
                         SelectedItem="{Binding SelectedCategory}" />

                <!-- Result count and page size -->
                <DockPanel Grid.Row="2" Margin="0,6,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Riviä sivulla" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 ItemsSource="{Binding Pager.PageSizes}"
                                 SelectedItem="{Binding Pager.PageSize}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Pager.ResultText}" Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <!-- Column headings -->
                <Border Grid.Row="3" Background="{StaticResource Brush.SurfaceMuted}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.4*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="108" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Kuva" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Nro" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Nimi" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Kategoriat" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Hinta" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Tarjoushinta" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Toiminnot" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!-- Rows -->
                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PageProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,0,4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="1.4*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="108" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail. The placeholder icon sits behind the Image, so
                                             a product with no picture — or one whose file is gone —
                                             shows the icon through it. -->
                                        <Border Grid.Column="0" Width="40" Height="40" CornerRadius="7"
                                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                                Background="{StaticResource Brush.SurfaceMuted}"
                                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                            <Grid>
                                                <ContentControl Style="{StaticResource Icon}"
                                                                Tag="{StaticResource Icon.Image}"
                                                                Width="16" Height="16"
                                                                Foreground="{StaticResource Brush.Border}" />
                                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>

                                        <TextBlock Grid.Column="1" Text="{Binding Product.Id}"
                                                   Style="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Product.Name}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Text}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <!-- IsPublic = 0: kept in the catalogue, hidden from the till -->
                                                <Border Style="{StaticResource Badge}" Margin="8,0,0,0"
                                                        Visibility="{Binding Product.IsHidden, Converter={StaticResource BoolToVis}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Style="{StaticResource Icon}"
                                                                        Tag="{StaticResource Icon.EyeOff}"
                                                                        Width="11" Height="11"
                                                                        Foreground="{StaticResource Brush.TextMuted}"
                                                                        VerticalAlignment="Center" />
                                                        <TextBlock Text="Piilotettu" FontSize="11" Margin="5,0,0,0"
                                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Product.Description}"
                                                       Style="{StaticResource Text.Muted}" FontSize="12"
                                                       Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding Product.CategoryNames}"
                                                   Style="{StaticResource Text.Muted}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,10,0"
                                                   TextTrimming="CharacterEllipsis" />

                                        <TextBlock Grid.Column="4" Text="{Binding Product.Price, StringFormat={}{0:N2} €}"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   FontSize="14"
                                                   Foreground="{StaticResource Brush.Text}" />

                                        <TextBlock Grid.Column="5" Text="{Binding Product.SalePrice, StringFormat={}{0:N2} €, TargetNullValue=–}"
                                                   VerticalAlignment="Center" TextAlignment="Right"
                                                   FontSize="14">
                                            <TextBlock.Style>
                                                <!-- Red only for a real offer; the placeholder dash stays muted -->
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Product.IsOnSale}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Danger}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel Grid.Column="6" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Icon}"
                                                    Tag="{StaticResource Icon.Eye}"
                                                    ToolTip="Näytä tiedot"
                                                    AutomationProperties.Name="Näytä tiedot"
                                                    Margin="0,0,6,0"
                                                    Click="View_Click" />
                                            <Button Style="{StaticResource Button.Icon}"
                                                    Tag="{StaticResource Icon.Pencil}"
                                                    ToolTip="Muokkaa"
                                                    AutomationProperties.Name="Muokkaa"
                                                    Click="Edit_Click" />
                                            <Button Style="{StaticResource Button.IconDanger}"
                                                    Tag="{StaticResource Icon.Trash}"
                                                    ToolTip="Poista"
                                                    AutomationProperties.Name="Poista"
                                                    Margin="6,0,0,0"
                                                    Click="Delete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="4" Text="Hakua vastaavia tuotteita ei löytynyt."
                           Style="{StaticResource Text.Muted}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Pager.HasNoResults, Converter={StaticResource BoolToVis}}" />

                <!-- Pagination -->
                <DockPanel Grid.Row="5" Margin="0,12,0,0"
                           Visibility="{Binding Pager.HasResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Pager.PageText}"
                               Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Icon}"
                                Tag="{StaticResource Icon.ChevronLeft}"
                                ToolTip="Edellinen sivu"
                                AutomationProperties.Name="Edellinen sivu"
                                IsEnabled="{Binding Pager.HasPreviousPage}"
                                Click="PreviousPage_Click" />

                        <ItemsControl ItemsSource="{Binding Pager.PageNumbers}" Margin="6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Page}"
                                            Content="{Binding Number}"
                                            Tag="{Binding IsCurrent}"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Click="PageNumber_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource Button.Icon}"
                                Tag="{StaticResource Icon.ChevronRight}"
                                ToolTip="Seuraava sivu"
                                AutomationProperties.Name="Seuraava sivu"
                                IsEnabled="{Binding Pager.HasNextPage}"
                                Click="NextPage_Click" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
