<UserControl x:Class="JussiMiniPos.Views.AdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- A vertical select box. The app's other pickers are chip lists, but
             each model needs a line of explanation to be choosable at all, so
             this keeps the chip's selected/hover language in a stacked row. -->
        <Style x:Key="ModelItem" TargetType="ListBoxItem">
            <Setter Property="AutomationProperties.Name" Value="{Binding Id}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="14,11" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Radio dot: the outer ring is always there,
                                     the filled centre only when selected. -->
                                <Grid Grid.Column="0" Width="18" Height="18"
                                      Margin="0,1,12,0" VerticalAlignment="Top">
                                    <Ellipse Stroke="{StaticResource Brush.Border}" StrokeThickness="1.5" />
                                    <Ellipse x:Name="Dot" Margin="4"
                                             Fill="{StaticResource Brush.Accent}"
                                             Visibility="Collapsed" />
                                </Grid>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Id}"
                                               FontFamily="Consolas" FontSize="13"
                                               Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Text="{Binding Description}"
                                               Style="{StaticResource Text.Muted}"
                                               FontSize="12" Margin="0,4,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                                <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Button Style="{StaticResource Button.Ghost}" Click="Back_Click" Padding="10,0"
                    AutomationProperties.Name="Takaisin">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.ArrowLeft}"
                                    Width="16" Height="16"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Takaisin" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Admin" Style="{StaticResource Text.SectionHeader}"
                       FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center" />

            <!-- Which account is making the change, since only an
                 administrator got this far. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,2,0,0"
                        Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <ContentControl Style="{StaticResource Icon}"
                                Tag="{StaticResource Icon.User}"
                                Width="14" Height="14"
                                Foreground="{StaticResource Brush.TextMuted}"
                                VerticalAlignment="Center" />
                <TextBlock Text="{Binding SignedInText}" Margin="7,0,0,0"
                           Style="{StaticResource Text.Muted}" FontSize="13"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- ============ Settings ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0"
                MaxWidth="1000" MaxHeight="620"
                HorizontalAlignment="Left" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- The scroller is a safety net for a short window; at the
                     normal size the two columns fit without it. -->
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,24,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="300" />
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" MinWidth="300" />
                        </Grid.ColumnDefinitions>

                        <!-- ===== Left: on/off and the key ===== -->
                        <StackPanel Grid.Column="0">

                            <TextBlock Text="AI-avustaja" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                       Margin="0,7,0,0" TextWrapping="Wrap"
                                       Text="Avustaja etsii tuotesuosituksia kassan valikoimasta. Kun se ei ole käytössä, sen painike ei näy kassassa lainkaan." />

                            <CheckBox x:Name="EnabledBox" Margin="0,14,0,0"
                                      Style="{StaticResource FormCheckBox}"
                                      Content="AI-avustaja käytössä kassassa"
                                      Checked="Enabled_Changed"
                                      Unchecked="Enabled_Changed" />

                            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,20" />

                            <TextBlock Text="Gemini API -avain" Style="{StaticResource Text.SectionHeader}"
                                       Opacity="{Binding SectionOpacity}" />

                            <StackPanel IsEnabled="{Binding IsAiEnabled}" Opacity="{Binding SectionOpacity}">
                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap">
                                    <Run Text="Avain haetaan Google AI Studiosta. Kirjaudu Google-tilillä, valitse" />
                                    <Run Text="“Create API key”" FontWeight="SemiBold" />
                                    <Run Text="ja kopioi avain tähän. Ilmainen taso riittää tähän käyttöön." />
                                    <LineBreak />
                                    <Hyperlink NavigateUri="https://aistudio.google.com/apikey"
                                               RequestNavigate="OpenLink_RequestNavigate"
                                               Foreground="{StaticResource Brush.Accent}"
                                               AutomationProperties.Name="Avaa Google AI Studio selaimessa"
                                               ToolTip="Avaa selaimessa">aistudio.google.com/apikey</Hyperlink>
                                </TextBlock>

                                <PasswordBox x:Name="KeyBox" Margin="0,12,0,0"
                                             Style="{StaticResource FormPasswordBox}"
                                             AutomationProperties.Name="Gemini API -avain"
                                             PasswordChanged="Key_Changed" />

                                <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                           Margin="0,7,0,0" TextWrapping="Wrap"
                                           Text="{Binding KeyStatusText}" />

                                <!-- Only shown when a variable is standing in,
                                     so an empty field beside a working
                                     assistant is explained. -->
                                <Border Background="{StaticResource Brush.SurfaceMuted}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="12,9" Margin="0,10,0,0"
                                        Visibility="{Binding HasEnvironmentKey, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                               TextWrapping="Wrap"
                                               Text="{Binding EnvironmentKeyText}" />
                                </Border>

                                <Button Style="{StaticResource Button.Ghost}"
                                        Margin="0,8,0,0" Padding="0" Height="32"
                                        HorizontalAlignment="Left"
                                        Foreground="{StaticResource Brush.Danger}"
                                        Content="Poista tallennettu avain"
                                        Click="ClearKey_Click"
                                        AutomationProperties.Name="Poista tallennettu avain"
                                        Visibility="{Binding HasStoredKey, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ===== Right: the model ===== -->
                        <StackPanel Grid.Column="2"
                                    IsEnabled="{Binding IsAiEnabled}"
                                    Opacity="{Binding SectionOpacity}">
                            <TextBlock Text="Malli" Style="{StaticResource Text.SectionHeader}" />
                            <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                       Margin="0,7,0,12" TextWrapping="Wrap"
                                       Text="Halvin malli riittää tuotesuosituksiin. Jos malli poistuu käytöstä, valitse tästä toinen." />

                            <ListBox x:Name="ModelList"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ItemContainerStyle="{StaticResource ModelItem}"
                                     ItemsSource="{Binding Models}"
                                     AutomationProperties.Name="Gemini-malli"
                                     SelectionChanged="Model_Changed" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- ============ Save ============ -->
                <StackPanel Grid.Row="1" Margin="24,0,24,22">
                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,16" />
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}">
                            <ContentControl Style="{StaticResource Icon}"
                                            Tag="{Binding StatusIcon}"
                                            Width="17" Height="17"
                                            Foreground="{Binding StatusBrush}"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="{Binding StatusText}" Margin="8,0,0,0"
                                       FontSize="13" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="420"
                                       Foreground="{Binding StatusBrush}" />
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Button.Primary}"
                                Width="160"
                                Content="Tallenna"
                                Click="Save_Click"
                                IsEnabled="{Binding HasChanges}"
                                AutomationProperties.Name="Tallenna asetukset" />

                        <!-- Tests what is on screen, not what is saved, so a
                             pasted key can be checked before committing it. -->
                        <Button DockPanel.Dock="Right"
                                Style="{StaticResource Button.Ghost}"
                                Height="46" Padding="18,0" Margin="0,0,10,0"
                                Content="Testaa yhteys"
                                Click="Test_Click"
                                IsEnabled="{Binding CanTest}"
                                AutomationProperties.Name="Testaa yhteys Gemini-rajapintaan" />
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
