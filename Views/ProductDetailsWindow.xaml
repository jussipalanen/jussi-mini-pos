<Window x:Class="JussiMiniPos.Views.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="580" Height="720"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="18" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,22,24,0">
                <StackPanel>

                    <!-- ===== Heading with the feature image ===== -->
                    <StackPanel Orientation="Horizontal">
                        <Border Width="112" Height="112" CornerRadius="10"
                                Background="{StaticResource Brush.SurfaceMuted}"
                                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                            <Grid>
                                <ContentControl Style="{StaticResource Icon}"
                                                Tag="{StaticResource Icon.Image}"
                                                Width="32" Height="32"
                                                Foreground="{StaticResource Brush.Border}" />
                                <Image Source="{Binding FeatureThumbnail}" Stretch="UniformToFill" />
                            </Grid>
                        </Border>

                        <StackPanel VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="360">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Product.Name}"
                                           FontSize="22" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}"
                                           TextWrapping="Wrap" />
                                <Border Style="{StaticResource Badge}" Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding Product.IsHidden, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <ContentControl Style="{StaticResource Icon}"
                                                        Tag="{StaticResource Icon.EyeOff}"
                                                        Width="11" Height="11"
                                                        Foreground="{StaticResource Brush.TextMuted}"
                                                        VerticalAlignment="Center" />
                                        <TextBlock Text="Piilotettu" FontSize="11" Margin="5,0,0,0"
                                                   Foreground="{StaticResource Brush.TextMuted}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding Product.Id, StringFormat=Tuotenumero {0}}"
                                       Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Product.EffectivePrice, StringFormat={}{0:N2} €}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="{StaticResource Brush.Text}" />
                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N2} €}"
                                           Style="{StaticResource Text.Muted}"
                                           TextDecorations="Strikethrough"
                                           VerticalAlignment="Bottom" Margin="10,0,0,4"
                                           Visibility="{Binding Product.IsOnSale, Converter={StaticResource BoolToVis}}" />
                                <Border Style="{StaticResource Badge}" Margin="8,0,0,4"
                                        VerticalAlignment="Bottom"
                                        Background="{StaticResource Brush.DangerSurface}"
                                        BorderBrush="{StaticResource Brush.Danger}"
                                        Visibility="{Binding Product.IsOnSale, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="TARJOUS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Danger}" />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,20,0,18" />

                    <!-- ===== Description ===== -->
                    <TextBlock Text="Kuvaus" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding DescriptionText}"
                               Foreground="{StaticResource Brush.Text}"
                               TextWrapping="Wrap" Margin="0,6,0,0" />

                    <!-- ===== Categories ===== -->
                    <TextBlock Text="Kategoriat" Style="{StaticResource Text.Muted}" FontWeight="SemiBold"
                               Margin="0,18,0,6" />
                    <ItemsControl ItemsSource="{Binding Product.Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Badge}" Margin="0,0,6,6" Padding="10,4">
                                    <TextBlock Style="{StaticResource Text.Muted}" FontSize="12">
                                        <Run Text="{Binding Id, Mode=OneWay}" />
                                        <Run Text="·" />
                                        <Run Text="{Binding Title, Mode=OneWay}" />
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ===== Gallery ===== -->
                    <TextBlock Text="Galleria" Style="{StaticResource Text.Muted}" FontWeight="SemiBold"
                               Margin="0,14,0,6" />
                    <TextBlock Text="Ei kuvia." Style="{StaticResource Text.Muted}" FontSize="12"
                               Visibility="{Binding HasNoGallery, Converter={StaticResource BoolToVis}}" />
                    <ItemsControl ItemsSource="{Binding Gallery}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="92" Height="92" CornerRadius="8" Margin="0,0,8,8"
                                        Background="{StaticResource Brush.SurfaceMuted}"
                                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                                        ToolTip="{Binding RelativePath}">
                                    <Grid>
                                        <ContentControl Style="{StaticResource Icon}"
                                                        Tag="{StaticResource Icon.Image}"
                                                        Width="22" Height="22"
                                                        Foreground="{StaticResource Brush.Border}" />
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ===== Sales so far ===== -->
                    <TextBlock Text="Myynti" Style="{StaticResource Text.Muted}" FontWeight="SemiBold"
                               Margin="0,14,0,6" />
                    <Border Background="{StaticResource Brush.SurfaceMuted}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            CornerRadius="9" Padding="14,12" Margin="0,0,0,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Myyty" Style="{StaticResource Text.Muted}" FontSize="12" />
                                <TextBlock Text="{Binding Sales.Quantity, StringFormat={}{0} kpl}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Myyntirivejä" Style="{StaticResource Text.Muted}" FontSize="12" />
                                <TextBlock Text="{Binding Sales.Lines}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Kertymä" Style="{StaticResource Text.Muted}" FontSize="12" />
                                <TextBlock Text="{Binding Sales.Revenue, StringFormat={}{0:N2} €}"
                                           FontSize="17" FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="1" Margin="24,0,24,20">
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,0,0,16" />
                <Button Style="{StaticResource Button.Primary}" Width="140"
                        HorizontalAlignment="Right"
                        Content="Sulje" IsCancel="True" IsDefault="True"
                        AutomationProperties.Name="Sulje"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
