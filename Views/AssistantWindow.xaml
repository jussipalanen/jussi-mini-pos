<Window x:Class="JussiMiniPos.Views.AssistantWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignHeight="720" d:DesignWidth="640"
        Title="AI-avustaja"
        Width="760" Height="820"
        MinWidth="620" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Sized for a till: this is a button a cashier hits in a hurry, so
             it keeps the full 44px height rather than shrinking to fit the
             row. The row grows around it instead. 13px rather than 14: the
             full "Lisää ostoskoriin" has to fit the action column without the
             column eating the product name beside it. -->
        <Style x:Key="AddButton" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Secondary to the per-row buttons: five blue buttons plus a sixth
             would read as six equal choices. -->
        <Style x:Key="AddAllButton" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Accent}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.SurfacePressed}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="18" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Header ============ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Sparkles}"
                                    Width="22" Height="22"
                                    Foreground="{StaticResource Brush.Accent}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="AI-avustaja" Style="{StaticResource Text.SectionHeader}"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                           Margin="0,7,0,0" TextWrapping="Wrap"
                           Text="Kysy suomeksi, millaista tuotetta asiakas etsii. Avustaja etsii vain kassan omasta valikoimasta." />
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,14" />
            </StackPanel>

            <!-- ============ Example questions ============ -->
            <!-- No heading: the chips read as what they are, and the vertical
                 space is better spent on results. -->
            <StackPanel Grid.Row="1">
                <ListBox x:Name="ExampleList"
                         Style="{StaticResource ChipList}"
                         ItemContainerStyle="{StaticResource ChipItem}"
                         ItemsSource="{Binding Examples}"
                         DisplayMemberPath="Title"
                         SelectionChanged="Example_SelectionChanged" />
            </StackPanel>

            <!-- ============ Question ============ -->
            <Grid Grid.Row="2" Margin="0,2,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Two lines' worth: a till question is short, and the room
                     is worth more to the results below. It scrolls if a longer
                     one gets typed. -->
                <TextBox x:Name="QuestionBox"
                         Grid.Row="0"
                         Style="{StaticResource FormBox}"
                         Height="62"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalContentAlignment="Top"
                         VerticalScrollBarVisibility="Auto"
                         AutomationProperties.Name="Kysymys avustajalle"
                         PreviewKeyDown="QuestionBox_PreviewKeyDown"
                         Text="{Binding QuestionText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- LastChildFill would stretch the button across the row
                     instead of docking it right. -->
                <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left"
                               Style="{StaticResource Text.Muted}" FontSize="12"
                               VerticalAlignment="Center"
                               Text="Enter lähettää, Vaihto+Enter vaihtaa riviä." />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Primary}"
                            Width="150"
                            Click="Ask_Click"
                            IsEnabled="{Binding CanAsk}"
                            AutomationProperties.Name="Kysy avustajalta">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icon}"
                                            Tag="{StaticResource Icon.Sparkles}"
                                            Width="17" Height="17"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="Kysy" Margin="9,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </DockPanel>
            </Grid>

            <!-- ============ Answer ============ -->
            <Grid Grid.Row="3" Margin="0,16,0,0">

                <!-- Nothing asked yet -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsIdle, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Sparkles}"
                                    Width="44" Height="44"
                                    Foreground="{StaticResource Brush.Border}"
                                    HorizontalAlignment="Center" />
                    <TextBlock Text="Ehdotukset näkyvät tässä" Style="{StaticResource Text.Muted}"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Esimerkiksi “Mitä sopii kahvin kanssa?”"
                               Style="{StaticResource Text.Muted}" FontSize="12"
                               Margin="0,4,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- Waiting for the model -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsAsking, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Loader}"
                                    Width="40" Height="40"
                                    Foreground="{StaticResource Brush.Accent}"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="0" />
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.9"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>
                    <TextBlock Text="Etsitään sopivia tuotteita…" Style="{StaticResource Text.Muted}"
                               Margin="0,16,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- The answer itself -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-4,0"
                              Visibility="{Binding HasAnswer, Converter={StaticResource BoolToVis}}">
                    <StackPanel Margin="0,0,4,0">

                        <!-- Degraded answer: no API key, or the call failed -->
                        <Border Background="{StaticResource Brush.DangerSurface}"
                                BorderBrush="{StaticResource Brush.Danger}"
                                BorderThickness="1" CornerRadius="10"
                                Padding="12,10" Margin="0,0,0,14"
                                Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Left"
                                                Style="{StaticResource Icon}"
                                                Tag="{StaticResource Icon.CircleAlert}"
                                                Width="17" Height="17"
                                                Foreground="{StaticResource Brush.Danger}"
                                                VerticalAlignment="Top" Margin="0,1,10,0" />
                                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Danger}" />
                            </DockPanel>
                        </Border>

                        <!-- The reply and "add everything" share a line: the
                             reply is a sentence or two, and the room below is
                             worth more to the products. -->
                        <DockPanel Margin="0,0,0,14">
                            <!-- Only worth offering for more than one
                                 suggestion; for a single row it would just be
                                 that row's own button in a second place. -->
                            <Button DockPanel.Dock="Right"
                                    Style="{StaticResource AddAllButton}"
                                    Margin="14,0,0,0" VerticalAlignment="Top"
                                    Click="AddAll_Click"
                                    AutomationProperties.Name="Lisää kaikki ostoskoriin"
                                    Visibility="{Binding HasSeveralSuggestions, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <ContentControl Style="{StaticResource Icon}"
                                                    Tag="{StaticResource Icon.Plus}"
                                                    Width="15" Height="15"
                                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                    VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding AddAllText}" Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="{Binding Reply}" TextWrapping="Wrap"
                                       FontSize="14" LineHeight="20"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.Text}"
                                       Visibility="{Binding HasReply, Converter={StaticResource BoolToVis}}" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Suggestions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource Brush.SurfaceMuted}"
                                            BorderBrush="{StaticResource Brush.Border}"
                                            BorderThickness="1" CornerRadius="10"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <!-- Fixed, so prices and buttons line up in a
                                                     column down the list however long a price
                                                     happens to be. 168 fits the whole "Lisää
                                                     ostoskoriin" label, which measures 121, and
                                                     leaves the rest to the product name. -->
                                                <ColumnDefinition Width="168" />
                                            </Grid.ColumnDefinitions>

                                            <!-- As in the till list, the placeholder icon sits
                                                 behind the Image and shows through when there
                                                 is no picture. -->
                                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="8"
                                                    Margin="0,0,14,0" VerticalAlignment="Top"
                                                    Background="{StaticResource Brush.Surface}"
                                                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                                                <Grid>
                                                    <ContentControl Style="{StaticResource Icon}"
                                                                    Tag="{StaticResource Icon.Image}"
                                                                    Width="20" Height="20"
                                                                    Foreground="{StaticResource Brush.Border}" />
                                                    <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding Product.Name}"
                                                           FontSize="15" FontWeight="SemiBold"
                                                           Foreground="{StaticResource Brush.Text}"
                                                           TextTrimming="CharacterEllipsis" />

                                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                    <TextBlock Text="{Binding Product.Id}"
                                                               Style="{StaticResource Text.Muted}"
                                                               FontSize="12" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                        <TextBlock Text="{Binding Product.PrimaryCategory}"
                                                                   Style="{StaticResource Text.Muted}" FontSize="11" />
                                                    </Border>
                                                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                            Background="{StaticResource Brush.DangerSurface}"
                                                            BorderBrush="{StaticResource Brush.Danger}"
                                                            Visibility="{Binding Product.IsOnSale, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="TARJOUS" FontSize="11" FontWeight="SemiBold"
                                                                   Foreground="{StaticResource Brush.Danger}" />
                                                    </Border>

                                                    <!-- How many have gone in so far. It lives in
                                                         this row, whose height is already fixed by
                                                         the badges, so the first click cannot grow
                                                         the card and shift the ones below it out
                                                         from under the pointer. -->
                                                    <Border Style="{StaticResource Badge}" Margin="6,0,0,0"
                                                            Background="Transparent"
                                                            BorderBrush="{StaticResource Brush.Success}"
                                                            Visibility="{Binding HasAdded, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <ContentControl Style="{StaticResource Icon}"
                                                                            Tag="{StaticResource Icon.CircleCheck}"
                                                                            Width="12" Height="12"
                                                                            Foreground="{StaticResource Brush.Success}"
                                                                            VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding AddedText}" Margin="5,0,0,0"
                                                                       FontSize="11" FontWeight="SemiBold"
                                                                       VerticalAlignment="Center"
                                                                       Foreground="{StaticResource Brush.Success}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding Reason}"
                                                           Style="{StaticResource Text.Muted}"
                                                           FontSize="12" TextWrapping="Wrap"
                                                           Margin="0,7,0,0"
                                                           Visibility="{Binding HasReason, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Product.Price, StringFormat={}{0:N2} €}"
                                                           Style="{StaticResource Text.Muted}" FontSize="12"
                                                           TextDecorations="Strikethrough"
                                                           HorizontalAlignment="Right"
                                                           Visibility="{Binding Product.IsOnSale, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding Product.EffectivePrice, StringFormat={}{0:N2} €}"
                                                           FontSize="18" FontWeight="Bold"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{StaticResource Brush.Text}" />

                                                <!-- Stretched to the column, so every row offers
                                                     the same target. It stays put after a click:
                                                     clicking it again adds another one, which is
                                                     quicker than going to the cart's steppers for
                                                     a second coffee. -->
                                                <Button Style="{StaticResource AddButton}"
                                                        Margin="0,10,0,0"
                                                        HorizontalAlignment="Stretch"
                                                        Click="AddToCart_Click"
                                                        AutomationProperties.Name="Lisää ostoskoriin">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ContentControl Style="{StaticResource Icon}"
                                                                        Tag="{StaticResource Icon.Plus}"
                                                                        Width="16" Height="16"
                                                                        Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                                        VerticalAlignment="Center" />
                                                        <TextBlock Text="Lisää ostoskoriin" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ============ Footer ============ -->
            <StackPanel Grid.Row="4">
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,16,0,14" />
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                               Style="{StaticResource Text.Muted}" FontSize="12"
                               Text="{Binding AddedText}"
                               Visibility="{Binding HasAdded, Converter={StaticResource BoolToVis}}" />
                    <Button DockPanel.Dock="Right"
                            Style="{StaticResource Button.Ghost}"
                            Height="46" Padding="24,0"
                            Content="Sulje" IsCancel="True"
                            AutomationProperties.Name="Sulje"
                            Click="Close_Click" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
