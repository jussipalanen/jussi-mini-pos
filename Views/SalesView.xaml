<UserControl x:Class="JussiMiniPos.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Button Style="{StaticResource Button.Ghost}" Click="Back_Click" Padding="10,0"
                    AutomationProperties.Name="Takaisin">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.ArrowLeft}"
                                    Width="16" Height="16"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Takaisin" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Myynti" Style="{StaticResource Text.SectionHeader}"
                       FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Totals across every sale, not just this page -->
                <Border Grid.Row="0" Background="{StaticResource Brush.SurfaceMuted}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="9" Padding="16,12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Myyntejä" Style="{StaticResource Text.Muted}" FontSize="12" />
                            <TextBlock Text="{Binding SaleCount}" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Tuotteita" Style="{StaticResource Text.Muted}" FontSize="12" />
                            <TextBlock Text="{Binding TotalItems, StringFormat={}{0} kpl}"
                                       FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Kertymä" Style="{StaticResource Text.Muted}" FontSize="12" />
                            <TextBlock Text="{Binding GrandTotal, StringFormat={}{0:N2} €}"
                                       FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text}" Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <DockPanel Grid.Row="1" Margin="0,0,0,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Riviä sivulla" Style="{StaticResource Text.Muted}"
                                   VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ListBox Style="{StaticResource ChipList}"
                                 ItemContainerStyle="{StaticResource ChipItem}"
                                 ItemsSource="{Binding Pager.PageSizes}"
                                 SelectedItem="{Binding Pager.PageSize}"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="{Binding Pager.ResultText}" Style="{StaticResource Text.Muted}"
                               VerticalAlignment="Center" />
                </DockPanel>

                <Border Grid.Row="2" Background="{StaticResource Brush.SurfaceMuted}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                        CornerRadius="8" Padding="14,8" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="76" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Nro" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="Päivämäärä" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Maksutapa" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Tuotteita" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Summa" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                        <TextBlock Grid.Column="5" Text="Toiminnot" Style="{StaticResource Text.Muted}" FontWeight="SemiBold" TextAlignment="Right" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PageSales}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Brush.Surface}"
                                        BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="8"
                                        Padding="14,11" Margin="0,0,4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="76" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Id}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Grid.Column="1" Text="{Binding SoldAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   FontSize="14" VerticalAlignment="Center" />

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ContentControl Style="{StaticResource Icon}"
                                                            Tag="{StaticResource Icon.CreditCard}"
                                                            Width="15" Height="15"
                                                            Foreground="{StaticResource Brush.TextMuted}"
                                                            VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PaymentMethodName}"
                                                       Style="{StaticResource Text.Muted}"
                                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>

                                        <TextBlock Grid.Column="3" Text="{Binding ItemCount, StringFormat={}{0} kpl}"
                                                   Style="{StaticResource Text.Muted}"
                                                   VerticalAlignment="Center" TextAlignment="Right" />

                                        <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N2} €}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   VerticalAlignment="Center" TextAlignment="Right" />

                                        <StackPanel Grid.Column="5" Orientation="Horizontal"
                                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Button.Icon}"
                                                    Tag="{StaticResource Icon.Eye}"
                                                    ToolTip="Näytä myynti"
                                                    AutomationProperties.Name="Näytä myynti"
                                                    Click="View_Click" />
                                            <Button Style="{StaticResource Button.IconDanger}"
                                                    Tag="{StaticResource Icon.Trash}"
                                                    ToolTip="Poista myynti"
                                                    AutomationProperties.Name="Poista myynti"
                                                    Margin="6,0,0,0"
                                                    Click="Delete_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding Pager.HasNoResults, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Sales}"
                                    Width="42" Height="42"
                                    Foreground="{StaticResource Brush.Border}"
                                    HorizontalAlignment="Center" />
                    <TextBlock Text="Ei myyntejä vielä." Style="{StaticResource Text.Muted}"
                               Margin="0,14,0,0" HorizontalAlignment="Center" />
                </StackPanel>

                <DockPanel Grid.Row="4" Margin="0,12,0,0"
                           Visibility="{Binding Pager.HasResults, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Pager.PageText}"
                               Style="{StaticResource Text.Muted}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Icon}"
                                Tag="{StaticResource Icon.ChevronLeft}"
                                ToolTip="Edellinen sivu"
                                AutomationProperties.Name="Edellinen sivu"
                                IsEnabled="{Binding Pager.HasPreviousPage}"
                                Click="PreviousPage_Click" />

                        <ItemsControl ItemsSource="{Binding Pager.PageNumbers}" Margin="6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource Button.Page}"
                                            Content="{Binding Number}"
                                            Tag="{Binding IsCurrent}"
                                            AutomationProperties.Name="{Binding AutomationName}"
                                            Click="PageNumber_Click" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Style="{StaticResource Button.Icon}"
                                Tag="{StaticResource Icon.ChevronRight}"
                                ToolTip="Seuraava sivu"
                                AutomationProperties.Name="Seuraava sivu"
                                IsEnabled="{Binding Pager.HasNextPage}"
                                Click="NextPage_Click" />
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
