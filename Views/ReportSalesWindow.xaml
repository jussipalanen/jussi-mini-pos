<Window x:Class="JussiMiniPos.Views.ReportSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Päivän myynnit" Width="820" Height="520" MinWidth="620" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Background}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding Heading}" Style="{StaticResource Text.SectionHeader}" Margin="0,0,0,8" />
        <TextBlock Grid.Row="1" Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,0,0,12" />
        <DataGrid Grid.Row="2" Style="{StaticResource Table.ReadOnly}" ItemsSource="{Binding Sales}"
                  AutomationProperties.Name="Päivän myyntitapahtumat">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nro" Binding="{Binding Id}" Width="75" ElementStyle="{StaticResource Table.Text}" />
                <DataGridTextColumn Header="Kellonaika" Binding="{Binding SoldAt, StringFormat=HH:mm:ss}" Width="*" ElementStyle="{StaticResource Table.Text}" />
                <DataGridTextColumn Header="Kappaleita" Binding="{Binding ItemCount}" Width="105" ElementStyle="{StaticResource Table.Number}" />
                <DataGridTextColumn Header="Summa (€)" Binding="{Binding Total, StringFormat=N2}" Width="125" ElementStyle="{StaticResource Table.Number}" />
                <DataGridTemplateColumn Header="Tiedot" Width="100" CanUserSort="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="Näytä" Style="{StaticResource Button.Ghost}" Click="Details_Click" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <Button Grid.Row="3" Content="Sulje" Style="{StaticResource Button.Ghost}" HorizontalAlignment="Right"
                IsCancel="True" Margin="0,12,0,0" />
    </Grid>
</Window>
