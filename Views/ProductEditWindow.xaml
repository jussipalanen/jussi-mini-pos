<Window x:Class="JussiMiniPos.Views.ProductEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Muokkaa tuotetta"
        Width="520" SizeToContent="Height"
        MinHeight="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="18" Padding="22">
        <StackPanel>

            <TextBlock Text="{Binding HeaderText}" Style="{StaticResource Text.SectionHeader}" />
            <TextBlock Text="Muutokset tallennetaan tietokantaan."
                       Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />

            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,18,0,18" />

            <TextBlock Text="Nimi" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
            <TextBox x:Name="TitleBox" Style="{StaticResource FormBox}" />

            <TextBlock Text="Kuvaus" Style="{StaticResource Text.Muted}" Margin="0,14,0,6" />
            <TextBox x:Name="DescriptionBox" Style="{StaticResource FormBox}"
                     Height="66" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalContentAlignment="Top" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Hinta (€)" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                    <TextBox x:Name="PriceBox" Style="{StaticResource FormBox}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Tarjoushinta (€, valinnainen)" Style="{StaticResource Text.Muted}" Margin="0,0,0,6" />
                    <TextBox x:Name="SalePriceBox" Style="{StaticResource FormBox}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Kategoriat" Style="{StaticResource Text.Muted}" Margin="0,16,0,6" />
            <ListBox x:Name="CategoryList"
                     Style="{StaticResource ChipList}"
                     ItemContainerStyle="{StaticResource ChipItem}"
                     DisplayMemberPath="Title"
                     SelectionMode="Multiple" />

            <CheckBox x:Name="PublicBox" Margin="0,10,0,0"
                      Style="{StaticResource FormCheckBox}"
                      Content="Näytetään kassassa" />

            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource Text.Muted}"
                       Foreground="{StaticResource Brush.Danger}"
                       TextWrapping="Wrap"
                       Margin="0,14,0,0"
                       Visibility="Collapsed" />

            <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,18,0,18" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Ghost}" Height="46" Padding="20,0"
                        Content="Peruuta" IsCancel="True"
                        AutomationProperties.Name="Peruuta"
                        Click="Cancel_Click" />
                <Button Style="{StaticResource Button.Primary}" Width="140" Margin="10,0,0,0"
                        Content="Tallenna" IsDefault="True"
                        AutomationProperties.Name="Tallenna"
                        Click="Save_Click" />
            </StackPanel>

        </StackPanel>
    </Border>
</Window>
