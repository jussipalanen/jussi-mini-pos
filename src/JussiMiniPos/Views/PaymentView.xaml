<UserControl x:Class="JussiMiniPos.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Button Style="{StaticResource Button.Ghost}" Click="Cancel_Click" Padding="10,0"
                    AutomationProperties.Name="Takaisin"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.ArrowLeft}"
                                    Width="16" Height="16"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Takaisin" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Maksu" Style="{StaticResource Text.SectionHeader}"
                       FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ============ Centred panel, one state at a time ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Width="540" Padding="34,30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>

                <!-- ===== 1. Choose a payment method ===== -->
                <StackPanel Visibility="{Binding IsChoosingMethod, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Maksettavaa" Style="{StaticResource Text.Muted}"
                               FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €}"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ItemSummary}" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,26,0,0" />

                    <TextBlock Text="Valitse maksutapa" Style="{StaticResource Text.Muted}"
                               FontSize="14" Margin="0,22,0,12" />

                    <!-- Add further methods here; each one is a PaymentMethod enum member. -->
                    <Button Style="{StaticResource Button.Pay}"
                            Click="PayWithCard_Click"
                            AutomationProperties.Name="Maksukortti">
                        <DockPanel LastChildFill="False">
                            <ContentControl DockPanel.Dock="Left"
                                            Style="{StaticResource Icon}"
                                            Tag="{StaticResource Icon.CreditCard}"
                                            Width="24" Height="24"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Maksukortti"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Total, StringFormat={}{0:N2} €}"
                                       VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold" />
                        </DockPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Pay}"
                            Margin="0,12,0,0"
                            Click="PayWithCash_Click"
                            AutomationProperties.Name="Käteinen">
                        <DockPanel LastChildFill="False">
                            <ContentControl DockPanel.Dock="Left"
                                            Style="{StaticResource Icon}"
                                            Tag="{StaticResource Icon.Banknote}"
                                            Width="24" Height="24"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Käteinen"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding CashTotal, StringFormat={}{0:N2} €}"
                                       VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold" />
                        </DockPanel>
                    </Button>
                    <TextBlock Text="{Binding CashRoundingText}" Style="{StaticResource Text.Muted}"
                               FontSize="12" HorizontalAlignment="Right" Margin="0,6,4,0"
                               Visibility="{Binding IsCashRounded, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <!-- ===== 1b. Counting the cash ===== -->
                <StackPanel Visibility="{Binding IsEnteringCash, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Käteisellä maksettavaa" Style="{StaticResource Text.Muted}"
                               FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding CashTotal, StringFormat={}{0:N2} €}"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding CashRoundingText}" Style="{StaticResource Text.Muted}"
                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"
                               Visibility="{Binding IsCashRounded, Converter={StaticResource BoolToVis}}" />

                    <TextBlock Text="Asiakkaan antama summa (€)" Style="{StaticResource Text.Muted}"
                               FontSize="14" Margin="0,22,0,6" />
                    <TextBox x:Name="CashReceivedBox" Style="{StaticResource FormBox}"
                             FontSize="22" Height="52"
                             AutomationProperties.Name="Annettu käteinen"
                             Text="{Binding CashReceivedText, UpdateSourceTrigger=PropertyChanged}" />

                    <ItemsControl ItemsSource="{Binding QuickAmounts}" Margin="0,10,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Ghost}" Height="40" Margin="0,0,6,0"
                                        Content="{Binding Label}"
                                        AutomationProperties.Name="{Binding Label}"
                                        Click="QuickAmount_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding CashHint}" Foreground="{StaticResource Brush.Danger}"
                               FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap"
                               Visibility="{Binding IsCashShort, Converter={StaticResource BoolToVis}}" />

                    <DockPanel Margin="0,18,0,0"
                               Visibility="{Binding HasChange, Converter={StaticResource BoolToVis}}">
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding Change, StringFormat={}{0:N2} €}"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="Takaisin" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextMuted}"
                                   VerticalAlignment="Center" />
                    </DockPanel>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,18,0,0" />

                    <DockPanel Margin="0,18,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}"
                                Height="52" Padding="18,0"
                                Content="Muu maksutapa"
                                AutomationProperties.Name="Muu maksutapa"
                                Click="BackToMethods_Click" />
                        <Button Style="{StaticResource Button.Primary}" Height="52" Margin="10,0,0,0"
                                Content="Vastaanota käteinen" IsDefault="True"
                                AutomationProperties.Name="Vastaanota käteinen"
                                IsEnabled="{Binding CanConfirmCash}"
                                Click="ConfirmCash_Click" />
                    </DockPanel>
                </StackPanel>

                <!-- ===== 2. Waiting for the terminal ===== -->
                <StackPanel Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center">
                    <ContentControl x:Name="Spinner"
                                    Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Loader}"
                                    Width="54" Height="54"
                                    Foreground="{StaticResource Brush.Accent}"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="0" />
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.9"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>

                    <TextBlock Text="{Binding ProcessingTitle}"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock Text="{Binding ProcessingHint}"
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>

                <!-- ===== 3. Done ===== -->
                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.CircleCheck}"
                                    Width="60" Height="60"
                                    Foreground="{StaticResource Brush.Success}"
                                    HorizontalAlignment="Center" />

                    <TextBlock Text="Maksu onnistui"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding PaidTotal, StringFormat={}{0:N2} €}"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <TextBlock Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Text="{Binding ReceiptSummary}" />

                    <!-- The change, big, because handing it over is the next thing to do -->
                    <Border Margin="0,20,0,0" Padding="16,12" CornerRadius="10"
                            Background="{StaticResource Brush.SurfaceMuted}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                            Visibility="{Binding HasSavedChange, Converter={StaticResource BoolToVis}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding SavedChange, StringFormat={}{0:N2} €}"
                                       FontSize="32" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="Anna takaisin" FontSize="18" FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextMuted}"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,26,0,0" />

                    <DockPanel Margin="0,22,0,0">
                        <Button DockPanel.Dock="Left" Style="{StaticResource Button.Ghost}"
                                Height="52" Padding="18,0" Margin="0,0,10,0"
                                Click="PrintReceipt_Click"
                                AutomationProperties.Name="Tulosta kuitti"
                                Content="Tulosta kuitti" />
                        <Button Style="{StaticResource Button.Primary}"
                                Click="Finish_Click"
                                AutomationProperties.Name="Uusi myynti"
                                Content="Uusi myynti" />
                    </DockPanel>
                </StackPanel>

                <!-- ===== 4. Something went wrong ===== -->
                <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.CircleAlert}"
                                    Width="60" Height="60"
                                    Foreground="{StaticResource Brush.Danger}"
                                    HorizontalAlignment="Center" />

                    <TextBlock Text="Maksu epäonnistui"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />

                    <Button Style="{StaticResource Button.Primary}"
                            Margin="0,26,0,0"
                            Click="Retry_Click"
                            AutomationProperties.Name="Yritä uudelleen"
                            Content="Yritä uudelleen" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
