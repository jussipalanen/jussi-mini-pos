<UserControl x:Class="JussiMiniPos.Views.PaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="760" d:DesignWidth="1200"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Header ============ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,18">
            <Button Style="{StaticResource Button.Ghost}" Click="Cancel_Click" Padding="10,0"
                    AutomationProperties.Name="Takaisin"
                    Visibility="{Binding CanCancel, Converter={StaticResource BoolToVis}}">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.ArrowLeft}"
                                    Width="16" Height="16"
                                    Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                    VerticalAlignment="Center" />
                    <TextBlock Text="Takaisin" Margin="7,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="Maksu" Style="{StaticResource Text.SectionHeader}"
                       FontSize="26" Margin="16,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ============ Centred panel, one state at a time ============ -->
        <Border Grid.Row="1" Style="{StaticResource Card}"
                Width="540" Padding="34,30"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>

                <!-- ===== 1. Choose a payment method ===== -->
                <StackPanel Visibility="{Binding IsChoosingMethod, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Maksettavaa" Style="{StaticResource Text.Muted}"
                               FontSize="15" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €}"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ItemSummary}" Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,26,0,0" />

                    <TextBlock Text="Valitse maksutapa" Style="{StaticResource Text.Muted}"
                               FontSize="14" Margin="0,22,0,12" />

                    <!-- Add further methods here; each one is a PaymentMethod enum member. -->
                    <Button Style="{StaticResource Button.Pay}"
                            Click="PayWithCard_Click"
                            AutomationProperties.Name="Maksukortti">
                        <DockPanel LastChildFill="False">
                            <ContentControl DockPanel.Dock="Left"
                                            Style="{StaticResource Icon}"
                                            Tag="{StaticResource Icon.CreditCard}"
                                            Width="24" Height="24"
                                            Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                            VerticalAlignment="Center" />
                            <TextBlock DockPanel.Dock="Left" Text="Maksukortti"
                                       Margin="12,0,0,0" VerticalAlignment="Center"
                                       FontSize="20" FontWeight="SemiBold" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Total, StringFormat={}{0:N2} €}"
                                       VerticalAlignment="Center"
                                       FontSize="22" FontWeight="Bold" />
                        </DockPanel>
                    </Button>
                </StackPanel>

                <!-- ===== 2. Waiting for the terminal ===== -->
                <StackPanel Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVis}}"
                            HorizontalAlignment="Center">
                    <ContentControl x:Name="Spinner"
                                    Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.Loader}"
                                    Width="54" Height="54"
                                    Foreground="{StaticResource Brush.Accent}"
                                    HorizontalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                        <ContentControl.RenderTransform>
                            <RotateTransform Angle="0" />
                        </ContentControl.RenderTransform>
                        <ContentControl.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0" To="360" Duration="0:0:0.9"
                                            RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ContentControl.Triggers>
                    </ContentControl>

                    <TextBlock Text="Odotetaan maksua…"
                               FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock Text="Seuraa maksupäätteen ohjeita."
                               Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €}"
                               FontSize="30" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,22,0,0" />
                </StackPanel>

                <!-- ===== 3. Done ===== -->
                <StackPanel Visibility="{Binding IsCompleted, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.CircleCheck}"
                                    Width="60" Height="60"
                                    Foreground="{StaticResource Brush.Success}"
                                    HorizontalAlignment="Center" />

                    <TextBlock Text="Maksu onnistui"
                               FontSize="28" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2} €}"
                               FontSize="46" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,14,0,0" />

                    <TextBlock Style="{StaticResource Text.Muted}"
                               HorizontalAlignment="Center" Margin="0,6,0,0"
                               Text="{Binding ReceiptSummary}" />

                    <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,26,0,0" />

                    <Button Style="{StaticResource Button.Primary}"
                            Margin="0,22,0,0"
                            Click="Finish_Click"
                            AutomationProperties.Name="Uusi myynti"
                            Content="Uusi myynti" />
                </StackPanel>

                <!-- ===== 4. Something went wrong ===== -->
                <StackPanel Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}">
                    <ContentControl Style="{StaticResource Icon}"
                                    Tag="{StaticResource Icon.CircleAlert}"
                                    Width="60" Height="60"
                                    Foreground="{StaticResource Brush.Danger}"
                                    HorizontalAlignment="Center" />

                    <TextBlock Text="Maksu epäonnistui"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               HorizontalAlignment="Center" Margin="0,20,0,0" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource Text.Muted}"
                               TextWrapping="Wrap" TextAlignment="Center"
                               HorizontalAlignment="Center" Margin="0,10,0,0" />

                    <Button Style="{StaticResource Button.Primary}"
                            Margin="0,26,0,0"
                            Click="PayWithCard_Click"
                            AutomationProperties.Name="Yritä uudelleen"
                            Content="Yritä uudelleen" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
