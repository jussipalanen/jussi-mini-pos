<Window x:Class="JussiMiniPos.Views.BackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Varmuuskopiot"
        Width="640" Height="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="18" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="22,20,22,0">
                <TextBlock Text="Varmuuskopiot" Style="{StaticResource Text.SectionHeader}" />
                <TextBlock Text="{Binding DatabaseText}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,16,0,0" />
            </StackPanel>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="22,16,22,0">
                <StackPanel>
                    <!-- ===== PostgreSQL: done on the server ===== -->
                    <Border Style="{StaticResource Badge}" Padding="14,10" HorizontalAlignment="Stretch"
                            Visibility="{Binding IsServer, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap" Style="{StaticResource Text.Muted}"
                                   Text="Tietokanta on PostgreSQL-palvelimella, joten se varmuuskopioidaan palvelimella pg_dump-työkalulla, esimerkiksi ajastetusti kerran yössä. Tuotekuvat ovat kunkin kassan omassa kansiossa; kopioi myös ne. Ohjeet ovat README-tiedostossa." />
                    </Border>

                    <StackPanel IsEnabled="{Binding IsSupported}">
                        <!-- ===== On demand ===== -->
                        <TextBlock Text="Varmuuskopioi nyt" Style="{StaticResource Text.SectionHeader}" FontSize="16" />
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Tietokanta ja tuotekuvat tallennetaan yhteen zip-tiedostoon. Kopion voi ottaa kesken päivän; myynnit eivät häiriinny." />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Primary}" Padding="18,0"
                                    Content="Varmuuskopioi…" AutomationProperties.Name="Varmuuskopioi nyt"
                                    Click="BackupNow_Click" />
                            <Button Style="{StaticResource Button.Ghost}" Height="46" Padding="18,0" Margin="10,0,0,0"
                                    Content="Palauta varmuuskopiosta…" AutomationProperties.Name="Palauta varmuuskopiosta"
                                    Click="Restore_Click" />
                        </StackPanel>

                        <!-- ===== Automatic ===== -->
                        <TextBlock Text="Automaattinen varmuuskopio" Style="{StaticResource Text.SectionHeader}" FontSize="16" Margin="0,24,0,0" />
                        <CheckBox x:Name="AutomaticBox" Margin="0,10,0,0"
                                  Style="{StaticResource FormCheckBox}"
                                  AutomationProperties.Name="Automaattinen varmuuskopio"
                                  Content="Varmuuskopioi kerran päivässä, kun kassa käynnistetään" />

                        <TextBlock Text="Kansio" Style="{StaticResource Text.Muted}" Margin="0,12,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Height="38" Padding="14,0" Margin="8,0,0,0"
                                    Content="Valitse…" AutomationProperties.Name="Valitse kansio"
                                    Click="ChooseFolder_Click" />
                            <TextBox x:Name="FolderBox" Style="{StaticResource FormBox}" AutomationProperties.Name="Varmuuskopiokansio" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Valitse mieluiten toinen levy, muistitikku tai pilveen synkronoitu kansio, ettei sama vika vie sekä tietokantaa että kopioita." />

                        <TextBlock Text="Säilytettävien kopioiden määrä" Style="{StaticResource Text.Muted}" Margin="0,12,0,6" />
                        <TextBox x:Name="KeepBox" Style="{StaticResource FormBox}" Width="100" HorizontalAlignment="Left"
                                 AutomationProperties.Name="Säilytettävien kopioiden määrä" />

                        <TextBlock Text="Kansion automaattiset kopiot" Style="{StaticResource Text.Muted}" Margin="0,16,0,6" />
                        <TextBlock Text="Ei vielä kopioita." Style="{StaticResource Text.Muted}" FontSize="12"
                                   Visibility="{Binding HasNoBackups, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Backups}" AutomationProperties.Name="Automaattiset kopiot">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Text.Muted}" FontSize="12" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock x:Name="StatusText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,14,0,0"
                               Visibility="Collapsed" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="22,0,22,20">
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,16,0,16" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Ghost}" Height="46" Padding="20,0"
                            Content="Sulje" IsCancel="True" AutomationProperties.Name="Sulje"
                            Click="Close_Click" />
                    <Button Style="{StaticResource Button.Primary}" Width="190" Margin="10,0,0,0"
                            Content="Tallenna asetukset" AutomationProperties.Name="Tallenna asetukset"
                            IsEnabled="{Binding IsSupported}"
                            Click="Save_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
