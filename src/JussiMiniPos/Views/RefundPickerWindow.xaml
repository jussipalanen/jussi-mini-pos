<Window x:Class="JussiMiniPos.Views.RefundPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Palautus" Width="820" Height="540" MinWidth="620" MinHeight="380"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border Style="{StaticResource Card}" Margin="18" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="22,20,22,12">
                <TextBlock Text="Palautus: päivän myynnit" Style="{StaticResource Text.SectionHeader}" />
                <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Muted}" Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <DataGrid x:Name="SaleGrid" Grid.Row="1" Margin="22,0,22,0" Style="{StaticResource Table.ReadOnly}"
                      ItemsSource="{Binding Sales}" SelectionMode="Single"
                      AutomationProperties.Name="Päivän myynnit"
                      MouseDoubleClick="SaleGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nro" Binding="{Binding Id}" Width="70" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Kellonaika" Binding="{Binding SoldAt, StringFormat=HH:mm}" Width="100" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Myyjä" Binding="{Binding SoldBy}" Width="*" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Maksutapa" Binding="{Binding PaymentMethodName}" Width="120" ElementStyle="{StaticResource Table.Text}" />
                    <DataGridTextColumn Header="Kappaleita" Binding="{Binding ItemCount}" Width="95" ElementStyle="{StaticResource Table.Number}" />
                    <DataGridTextColumn Header="Summa (€)" Binding="{Binding Total, StringFormat=N2}" Width="110" ElementStyle="{StaticResource Table.Number}" />
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="1" Text="Tänään ei ole myyntejä, joista voisi tehdä palautuksen."
                       Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

            <DockPanel Grid.Row="2" Margin="22,14,22,20" LastChildFill="False">
                <Button DockPanel.Dock="Left" Style="{StaticResource Button.Danger}" Padding="18,0"
                        Content="Palauta valittu…" AutomationProperties.Name="Palauta valittu myynti"
                        Click="Refund_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Ghost}" Height="46" Padding="20,0"
                        Content="Sulje" IsCancel="True" AutomationProperties.Name="Sulje"
                        Click="Close_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Window>
