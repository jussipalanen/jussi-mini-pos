<Window x:Class="JussiMiniPos.Views.SaleDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Width="560" Height="680"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI"
        Background="{StaticResource Brush.Background}">

    <Border Style="{StaticResource Card}" Margin="18" Padding="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ===== Heading ===== -->
            <StackPanel Grid.Row="0" Margin="24,22,24,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Sale.Total, StringFormat={}{0:N2} €}"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}"
                               VerticalAlignment="Center" />
                    <StackPanel>
                        <TextBlock Text="{Binding Sale.Id, StringFormat=Myynti #{0}}"
                                   Style="{StaticResource Text.SectionHeader}" />
                        <TextBlock Text="{Binding Sale.SoldAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                   Style="{StaticResource Text.Muted}" Margin="0,6,0,0" />
                    </StackPanel>
                </DockPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Border Style="{StaticResource Badge}" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icon}"
                                            Tag="{StaticResource Icon.CreditCard}"
                                            Width="14" Height="14"
                                            Foreground="{StaticResource Brush.TextMuted}"
                                            VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Sale.PaymentMethodName}"
                                       Style="{StaticResource Text.Muted}" FontSize="12"
                                       Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Badge}" Padding="10,5" Margin="6,0,0,0">
                        <TextBlock Text="{Binding Sale.ItemCount, StringFormat={}{0} kpl}"
                                   Style="{StaticResource Text.Muted}" FontSize="12" />
                    </Border>
                </StackPanel>

                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,18,0,0" />

                <TextBlock Text="Ostetut tuotteet" Style="{StaticResource Text.Muted}"
                           FontWeight="SemiBold" Margin="0,16,0,8" />
            </StackPanel>

            <!-- ===== Lines ===== -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,0,24,0">
                <ItemsControl ItemsSource="{Binding Sale.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource Brush.SurfaceMuted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="9"
                                    Padding="14,11" Margin="0,0,4,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding ProductId}"
                                                       Style="{StaticResource Text.Muted}" FontSize="12"
                                                       VerticalAlignment="Center" />
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                                <TextBlock Text="{Binding Category}"
                                                           Style="{StaticResource Text.Muted}" FontSize="11" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding LineTotal, StringFormat={}{0:N2} €}"
                                                   FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   HorizontalAlignment="Right" />
                                        <TextBlock Style="{StaticResource Text.Muted}" FontSize="12"
                                                   HorizontalAlignment="Right" Margin="0,3,0,0">
                                            <Run Text="{Binding Quantity, Mode=OneWay}" />
                                            <Run Text="×" />
                                            <Run Text="{Binding UnitPrice, StringFormat={}{0:N2}, Mode=OneWay}" />
                                            <Run Text="€" />
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- ===== Total and close ===== -->
            <StackPanel Grid.Row="2" Margin="24,0,24,20">
                <Border Height="1" Background="{StaticResource Brush.Border}" Margin="0,14,0,14" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding Sale.Total, StringFormat={}{0:N2} €}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock Text="Yhteensä" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextMuted}"
                               VerticalAlignment="Bottom" Margin="0,0,0,3" />
                </DockPanel>
                <Button Style="{StaticResource Button.Primary}" Width="140" Margin="0,18,0,0"
                        HorizontalAlignment="Right"
                        Content="Sulje" IsCancel="True" IsDefault="True"
                        AutomationProperties.Name="Sulje"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
